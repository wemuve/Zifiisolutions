# rlm_rest instance that hands every login and accounting record to ZiFii OS.
# Install: copy to /etc/freeradius/3.0/mods-available/zifii and link it into mods-enabled/.
# ZIFII_OS_URL and ZIFII_RADIUS_API_TOKEN come from FreeRADIUS's environment.

rest zifii {
	connect_uri = "$ENV{ZIFII_OS_URL}"
	connect_timeout = 2.0

	authorize {
		uri = "${..connect_uri}/radius/authorize"
		method = 'post'
		body = 'json'
		timeout = 3.0
	}

	accounting {
		uri = "${..connect_uri}/radius/accounting"
		method = 'post'
		body = 'json'
		timeout = 3.0
	}

	pool {
		start = 0
		min = 0
		max = 32
		spare = 4
		uses = 0
		retry_delay = 30
		lifetime = 0
		idle_timeout = 60
	}
}
