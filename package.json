{
  "name": "zifii-os",
  "version": "0.1.0",
  "description": "ZiFii OS: plans, entitlements and Wi-Fi logins for ZiFii sites",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wemuve/Zifiisolutions.git"
  },
  "bugs": {
    "url": "https://github.com/wemuve/Zifiisolutions/issues"
  },
  "homepage": "https://github.com/wemuve/Zifiisolutions#readme",
  "dependencies": {
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
